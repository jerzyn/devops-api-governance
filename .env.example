# With Docker the demo runs with no .env at all — `docker compose up` works out
# of the box. With Podman, set DOCKER_SOCK below.
# Copy to .env only to override the defaults below. .env is gitignored.

# --- Container engine socket ---
# Three services (gitea-seed, gitea-runner, krakend-deployer) talk to the
# container engine. Docker needs nothing here. Rootless Podman: enable its
# socket (systemctl --user enable --now podman.socket) and point at it, with
# your user id from `id -u` in place of 1000:
# DOCKER_SOCK=/run/user/1000/podman/podman.sock

# --- Seeded Gitea admin (used by gitea-seed and Backstage) ---
# GITEA_ADMIN_USER=demo
# GITEA_ADMIN_PASSWORD=demo12345

# --- Track B: contract testing ---
# Set to true to make the backend serve contract-violating responses
# (demonstrates a failing contract-test gate).
# BACKEND_DRIFT=false

# --- Optional: pin Gitea secrets (otherwise auto-generated + persisted in the
# gitea-data volume). Uncomment the matching lines in docker-compose.yml too.
# GITEA_SECRET_KEY=
# GITEA_INTERNAL_TOKEN=
# GITEA_LFS_JWT_SECRET=
# GITEA_OAUTH2_JWT_SECRET=
