#!/bin/bash
# One entry point for the recorded demo (presentation/screenplay.md). Tab
# completion and `demo-async shell` come from demo-completion.bash (see `demo-async help`).
set -euo pipefail
D="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

usage() {
  cat <<'USAGE'
demo-async <command> [args]

Between steps
  next                  prepare the next step's branch in the demo clone
  status                where the demo is, and what comes next
  preflight             "ready to record?" check (ends with READY or a list of problems)
  deny                  show the broker refusing what the policy does not grant

Retakes and setup
  goto <target>         roll back to the start of a step: 1 2 2-red 3 3-red 4 5 5-red kafka end
  reset                 same as: goto 1
  fresh [--yes]         wipe the demo Gitea and start over at Stage 1 (final take)
  refresh-catalog       make Backstage rescan Gitea now
  shell                 set up this terminal for recording (prompt, cd into the clone)

Advanced
  stage1 stage2 stage2-red stage3 stage3-red stage4 stage5 stage5-red kafka kafka-red
                        prepare one specific step's branch (next picks it for you)
USAGE
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  next|status|preflight|deny|reset|refresh-catalog|stage1|stage2|stage2-red|stage3|stage3-red|stage4|stage5|stage5-red|kafka|kafka-red)
    exec "$D/prep-stage.sh" "$cmd" "$@" ;;
  goto)
    [ $# -ge 1 ] || { echo "usage: demo-async goto <1|2|2-red|3|3-red|4|5|5-red|kafka|end>" >&2; exit 1; }
    exec "$D/prep-stage.sh" goto "$@" ;;
  fresh) exec "$D/fresh-gitea.sh" "$@" ;;
  shell)
    echo "'demo-async shell' has to change this terminal, so it works through the shell function:" >&2
    echo "  source $D/demo-completion.bash   (or run: demo-async install)" >&2
    exit 1 ;;
  install)
    line="source $D/demo-completion.bash"
    if grep -qxF "$line" "$HOME/.bashrc" 2>/dev/null; then
      echo "already in ~/.bashrc"
    else
      printf '\n# DevOps async API governance demo CLI (tab completion + demo-async shell)\n%s\n' "$line" >> "$HOME/.bashrc"
      echo "added to ~/.bashrc; open a new terminal (or: $line)"
    fi ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
