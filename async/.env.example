# With Docker the demo runs with no .env at all. Copy to .env only to override.

# --- Container engine socket ---
# Rootless Podman: enable its socket (systemctl --user enable --now podman.socket)
# and point at it, with your user id from `id -u` in place of 1000:
# DOCKER_SOCK=/run/user/1000/podman/podman.sock

# --- Seeded Gitea admin (used by gitea-seed and Backstage) ---
# GITEA_ADMIN_USER=demo
# GITEA_ADMIN_PASSWORD=demo12345

# --- Backend ---
# Set to true to publish contract-violating events.
# BACKEND_DRIFT=false
# How often the backend simulates an order (OrderCreated + OrderPaid), in ms.
# PUBLISH_INTERVAL_MS=1000
