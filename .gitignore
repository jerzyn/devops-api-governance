gitea-data/
gitea-data.backup-*/
.env
runner-data/
gitea-reset-backups/

# Backstage app source is committed; its own backstage/.gitignore excludes
# node_modules, dist, and .yarn caches.
*.local.sqlite

# IDE + stray tool logs
.idea/
*.log

# Stray runtime state (no service mounts this now; guard against re-tracking)
microcks-data/

# Agent tool state (index cache, local memory) - not part of the project
.lurus/

# Gateway generator's npm install (linked tooling, installed fresh by CI
# and by local development - never commit the resolved tree)
governance/gateway/node_modules/

# Local Docker-Desktop-less dev override (e.g. Podman socket path bind for
# gitea-seed/gitea-runner/krakend-deployer); docker compose auto-loads this
# file if present, so keep it machine-local and never commit it.
docker-compose.override.yml

# Subagent-driven-development scratch workspace (ledgers, briefs, review
# packages) - session-local working state, not project content.
.superpowers/

# Gateway generator's resolved lockfile - CI runs `npm install` (not
# `npm ci`), so there's no reproducibility story that requires committing it.
governance/gateway/package-lock.json
